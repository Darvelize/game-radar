<!--
  GameRadar design tokens: the ONLY place where colors, sizes, spacings and
  radii are written. Views and component styles reference these keys.

  Colors live in ThemeDictionaries: Avalonia picks the Light or Dark set from
  the Windows setting. Theme-dependent keys must be used with
  {DynamicResource ...} (re-read when the theme changes), fixed sizes may
  use {StaticResource ...}.

  Every text/background pair was checked against WCAG 2.1 AA (>= 4.5:1).
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <!-- Surfaces, from back to front -->
            <SolidColorBrush x:Key="BackgroundBrush" Color="#F6F5FA" />
            <SolidColorBrush x:Key="SidebarBrush" Color="#EFEDF6" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F3F1FC" />
            <SolidColorBrush x:Key="BorderBrush" Color="#E3E0EE" />
            <!-- Text -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1A22" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5E5B6E" />
            <!-- Brand -->
            <SolidColorBrush x:Key="AccentBrush" Color="#6B4EFF" />
            <!-- Accent for TEXT: a bit darker, to stay >= 4.5:1 even on AccentSubtle. -->
            <SolidColorBrush x:Key="AccentTextBrush" Color="#5B3EEB" />
            <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentSubtleBrush" Color="#ECE8FF" />
            <!-- Meaning -->
            <SolidColorBrush x:Key="GamePassBrush" Color="#107C10" />
            <SolidColorBrush x:Key="OnGamePassBrush" Color="#FFFFFF" />
            <!-- Platform badges in the platform's color (no logo, see Icons). White
                 text: Xbox 10.4:1, Steam ~16:1, PlayStation 4.95:1, GOG 7.4:1, EA 7.8:1, Epic 8.9:1 (a slate grey, apart from the near-black Steam). EA a wine red,
                 darker than the danger red of "Bientôt retiré", so both stay apart). Xbox much darker
                 than the Game Pass green, so both badges side by side stay apart. -->
            <SolidColorBrush x:Key="XboxBrush" Color="#0B4A0B" />
            <SolidColorBrush x:Key="SteamBrush" Color="#171A21" />
            <SolidColorBrush x:Key="PlayStationBrush" Color="#0070D1" />
            <SolidColorBrush x:Key="GogBrush" Color="#86328A" />
            <SolidColorBrush x:Key="EaBrush" Color="#A50F1E" />
            <SolidColorBrush x:Key="EpicBrush" Color="#4A4A4A" />
            <SolidColorBrush x:Key="OnPlatformBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="PlatformOutlineBrush" Color="Transparent" />
            <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />
            <SolidColorBrush x:Key="OnDangerBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="DangerSubtleBrush" Color="#FDE7E9" />
            <!-- "x-offset y-offset blur spread color" -->
            <BoxShadows x:Key="ShadowCard">0 1 3 0 #141A3D14</BoxShadows>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <!-- Not pure black: a tinted dark grey is easier on the eyes and
                 lets cards stand out with a slightly lighter surface. -->
            <SolidColorBrush x:Key="BackgroundBrush" Color="#121118" />
            <SolidColorBrush x:Key="SidebarBrush" Color="#17161E" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#1C1B24" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#262433" />
            <SolidColorBrush x:Key="BorderBrush" Color="#2E2C3A" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F1F7" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A9A6BA" />
            <!-- On dark, the accent gets lighter and text on it gets dark. -->
            <SolidColorBrush x:Key="AccentBrush" Color="#A08CFF" />
            <SolidColorBrush x:Key="AccentTextBrush" Color="#A08CFF" />
            <SolidColorBrush x:Key="OnAccentBrush" Color="#14121F" />
            <SolidColorBrush x:Key="AccentSubtleBrush" Color="#2A2545" />
            <SolidColorBrush x:Key="GamePassBrush" Color="#6CCB5F" />
            <SolidColorBrush x:Key="OnGamePassBrush" Color="#0E1A0C" />
            <!-- Same brand colors; the Steam black would vanish on the dark cards:
                 a thin outline keeps every platform badge's shape visible. -->
            <SolidColorBrush x:Key="XboxBrush" Color="#0B4A0B" />
            <SolidColorBrush x:Key="SteamBrush" Color="#000000" />
            <SolidColorBrush x:Key="PlayStationBrush" Color="#0070D1" />
            <SolidColorBrush x:Key="GogBrush" Color="#86328A" />
            <SolidColorBrush x:Key="EaBrush" Color="#A50F1E" />
            <SolidColorBrush x:Key="EpicBrush" Color="#4A4A4A" />
            <SolidColorBrush x:Key="OnPlatformBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="PlatformOutlineBrush" Color="#45434F" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FF99A4" />
            <SolidColorBrush x:Key="OnDangerBrush" Color="#3B0A10" />
            <SolidColorBrush x:Key="DangerSubtleBrush" Color="#3A1D22" />
            <BoxShadows x:Key="ShadowCard">0 1 3 0 #40000000</BoxShadows>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- Spacing scale (multiples of 4) -->
    <x:Double x:Key="Space1">4</x:Double>
    <x:Double x:Key="Space2">8</x:Double>
    <x:Double x:Key="Space3">12</x:Double>
    <x:Double x:Key="Space4">16</x:Double>
    <x:Double x:Key="Space5">24</x:Double>
    <x:Double x:Key="Space6">32</x:Double>
    <!-- Padding/Margin need a Thickness (4 sides), not a number. -->
    <Thickness x:Key="PaddingCard">16</Thickness>
    <Thickness x:Key="PaddingCardBody">16,12,16,16</Thickness>

    <!-- An empty shadow must still be a valid shadow value. -->
    <BoxShadows x:Key="ShadowNone">0 0 0 0 #00000000</BoxShadows>

    <!-- Radii -->
    <CornerRadius x:Key="RadiusXSmall">2</CornerRadius>
    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">12</CornerRadius>

    <!-- Type ramp -->
    <x:Double x:Key="FontSizeDisplay">28</x:Double>
    <x:Double x:Key="FontSizeTitle">20</x:Double>
    <x:Double x:Key="FontSizeSubtitle">16</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeCaption">12</x:Double>
    <x:Double x:Key="FontSizeBadge">11</x:Double>

    <!-- Motion: short and eased, so the UI feels responsive, never slow. -->
    <x:TimeSpan x:Key="DurationFast">0:0:0.12</x:TimeSpan>
    <x:TimeSpan x:Key="DurationNormal">0:0:0.2</x:TimeSpan>

</ResourceDictionary>
