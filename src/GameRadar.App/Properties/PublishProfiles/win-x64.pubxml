<?xml version="1.0" encoding="utf-8"?>
<!--
  Shareable build: a single GameRadar.exe that runs on any 64-bit Windows,
  without installing .NET.
    dotnet publish src/GameRadar.App -p:PublishProfile=win-x64
  Output: publish/GameRadar.exe (repository root, ignored by git).
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- The .NET runtime inside the exe: nothing to install for the people it is shared with. -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Avalonia's native libraries (SkiaSharp, HarfBuzz) inside the exe too:
         extracted to a temporary folder on the first launch. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- ~2x smaller, at the cost of a slightly slower first start. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- No .pdb next to the exe. -->
    <DebugType>none</DebugType>
    <!-- Trimmed (~22 MB instead of ~49): the code nobody calls is cut out. Safe
         because all our JSON goes through source-generated contexts (no
         reflection: JsonSerializerIsReflectionEnabledByDefault is off in
         GameRadar.App.csproj) and the XAML bindings are compiled. A new
         type written or read as JSON goes in the *JsonContext of its folder,
         or it fails in the exe. Back to false if a page of the published exe breaks. -->
    <PublishTrimmed>true</PublishTrimmed>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\publish\</PublishDir>
  </PropertyGroup>
</Project>
