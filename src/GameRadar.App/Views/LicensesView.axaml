<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameRadar.App.ViewModels"
             xmlns:res="using:GameRadar.App.Resources"
             xmlns:app="using:GameRadar.App"
             x:Class="GameRadar.App.Views.LicensesView"
             x:DataType="vm:MainWindowViewModel">

    <!-- Open-source licenses (THIRD-PARTY-NOTICES.txt), from "À propos": the
         list of components, then the texts their licenses ask to ship, folded
         (~220 KB in all). -->
    <!-- Same column as the settings tabs: up to 720 px whatever is unfolded
         (a left-aligned panel took the width of its widest text, and the
         cards grew when a section was unfolded). -->
    <ScrollViewer Name="Scroller">
        <Grid Margin="32,28,32,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1000*" MaxWidth="720" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
        <StackPanel Spacing="20">

            <!-- Back to "À propos"; Escape does the same (key binding on the MainWindow) -->
            <Button Classes="icon" Command="{Binding GoBackCommand}" HorizontalAlignment="Left"
                    ToolTip.Tip="{x:Static res:Strings.Common_Back_Tip}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Classes="icon secondary" Data="{StaticResource IconArrowLeft}" />
                    <TextBlock Classes="secondary" Text="{x:Static res:Strings.Common_Back}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <StackPanel Spacing="8">
                <TextBlock Classes="display" Text="{x:Static res:Strings.About_Licenses}" />
                <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{x:Static res:Strings.Licenses_Intro}" />
            </StackPanel>

            <!-- The components: one line each (copyright and site in the tooltip) -->
            <Border Classes="card">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,140,120" ColumnSpacing="12">
                        <TextBlock Classes="caption" FontWeight="SemiBold" Text="{x:Static res:Strings.Licenses_Component}" />
                        <TextBlock Grid.Column="1" Classes="caption" FontWeight="SemiBold" Text="{x:Static res:Strings.Licenses_Version}" />
                        <TextBlock Grid.Column="2" Classes="caption" FontWeight="SemiBold" Text="{x:Static res:Strings.Licenses_License}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Legal.LicensedComponents}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="app:LicensedComponent">
                                <Grid ColumnDefinitions="*,140,120" ColumnSpacing="12" Margin="0,3"
                                      Background="Transparent">
                                    <ToolTip.Tip>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Copyright}" />
                                            <TextBlock Text="{Binding Url}" />
                                        </StackPanel>
                                    </ToolTip.Tip>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Classes="secondary" Text="{Binding Version}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Classes="secondary" Text="{Binding License}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- The texts, folded: a click on the title unfolds one. Only the
                 paragraphs on screen are built (VirtualizingStackPanel). -->
            <ItemsControl ItemsSource="{Binding Legal.NoticeSections}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NoticeSectionRow">
                        <Border Classes="card flat">
                            <StackPanel>
                                <ToggleButton Classes="disclosure" IsChecked="{Binding IsExpanded}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <TextBlock Classes="subtitle" Text="{Binding Title}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <Path Grid.Column="1" Classes="icon secondary small chevron"
                                              Classes.expanded="{Binding IsExpanded}"
                                              Data="{StaticResource IconChevronDown}" />
                                    </Grid>
                                </ToggleButton>
                                <Border Classes="subrow" IsVisible="{Binding IsExpanded}">
                                    <ItemsControl ItemsSource="{Binding Paragraphs}"
                                                  ItemTemplate="{StaticResource LegalParagraphTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
        </Grid>
    </ScrollViewer>
</ContentPage>
