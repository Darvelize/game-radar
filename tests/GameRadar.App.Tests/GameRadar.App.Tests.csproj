<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- As in the exe: no JSON by reflection, so a type missing from a generated context fails here, not only once trimmed. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- xUnit v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!--
    UI tests only: none of these packages ship with the app.
    Avalonia.Headless.XUnit 12 is built on xUnit v3 (the Core tests stay on v2):
    xunit.v3 is pinned to the version it was compiled against.
  -->
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.3" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The .NET runtime the SDK puts in a self-contained exe: the third-party notices name this version. -->
  <ItemGroup>
    <AssemblyMetadata Include="BundledRuntimeVersion" Value="$(BundledNETCoreAppPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GameRadar.App\GameRadar.App.csproj" />
  </ItemGroup>

</Project>
